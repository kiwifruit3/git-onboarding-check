# ===== RepoPulse 环境变量示例（复制为 .env 使用，切勿提交真实值）=====

# 服务端口与监听地址
PORT=8787
HOST=127.0.0.1

# 缓存目录（默认 ./.cache）
# CHECK_CACHE_DIR=./.cache

# 代理：本机 git 代理失效时可用它显式指定
# REPOPULSE_PROXY=http://127.0.0.1:7890
# REPOPULSE_NO_PROXY=1

# GitHub Token：仅在 ls-remote 失败时用于 API 兜底
# GITHUB_TOKEN=

# ===== 可选：AI 接入建议（不配置则使用内置规则引擎，完全离线可用）=====
# OpenAI 兼容通道
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_MODEL=deepseek-chat

# 通义千问（DashScope 兼容模式）
# DASHSCOPE_API_KEY=sk-xxxx
# DASHSCOPE_MODEL=qwen-plus

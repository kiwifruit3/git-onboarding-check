{
  "name": "git-onboarding-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Git 仓库接入体检：README / 依赖清单 / 启动脚本完整度、Windows 专用脚本、硬编码路径、密钥风险，输出接入就绪度评分与风险清单",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.mjs",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server/index.mjs --prod",
    "test": "node tests/rules.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
